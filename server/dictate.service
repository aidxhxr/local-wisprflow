[Unit]
Description=Local dictation server (Parakeet TDT on GPU)
After=network.target
# A crash loop (a CUDA fault right after load, a model download that keeps failing) must not
# trip systemd's start-rate limit and leave the box without dictation until someone logs in.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/dictate
Environment=DICTATE_MODEL=nvidia/parakeet-tdt-0.6b-v2
Environment=DICTATE_HOST=127.0.0.1
Environment=DICTATE_PORT=8765
Environment=HF_HUB_DISABLE_PROGRESS_BARS=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStart=%h/dictate/.venv/bin/python %h/dictate/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
