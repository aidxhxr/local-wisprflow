[Unit]
Description=Local dictation server (Parakeet TDT on GPU)
After=network.target

[Service]
WorkingDirectory=%h/dictate
Environment=DICTATE_MODEL=nvidia/parakeet-tdt-0.6b-v2
Environment=DICTATE_HOST=127.0.0.1
Environment=DICTATE_PORT=8765
Environment=HF_HUB_DISABLE_PROGRESS_BARS=1
ExecStart=%h/dictate/.venv/bin/python %h/dictate/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
